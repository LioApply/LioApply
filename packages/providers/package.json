{
  "name": "@lioapply/providers",
  "version": "0.1.2",
  "description": "LioApply Injectable Job Providers (LinkedIn, Glassdoor, Remotar, Indeed, Remotive, GitHub Vagas, RSS) with subpath exports",
  "main": "../../dist/packages/providers/index.js",
  "types": "../../dist/packages/providers/index.d.ts",
  "exports": {
    ".": {
      "types": "../../dist/packages/providers/index.d.ts",
      "default": "../../dist/packages/providers/index.js"
    },
    "./linkedin": {
      "types": "../../dist/packages/providers/linkedin.d.ts",
      "default": "../../dist/packages/providers/linkedin.js"
    },
    "./glassdoor": {
      "types": "../../dist/packages/providers/glassdoor.d.ts",
      "default": "../../dist/packages/providers/glassdoor.js"
    },
    "./remotar": {
      "types": "../../dist/packages/providers/remotar.d.ts",
      "default": "../../dist/packages/providers/remotar.js"
    },
    "./indeed": {
      "types": "../../dist/packages/providers/indeed.d.ts",
      "default": "../../dist/packages/providers/indeed.js"
    },
    "./remotive": {
      "types": "../../dist/packages/providers/remotive.d.ts",
      "default": "../../dist/packages/providers/remotive.js"
    },
    "./github-vagas": {
      "types": "../../dist/packages/providers/github-vagas.d.ts",
      "default": "../../dist/packages/providers/github-vagas.js"
    },
    "./rss": {
      "types": "../../dist/packages/providers/rss.d.ts",
      "default": "../../dist/packages/providers/rss.js"
    }
  },
  "license": "MIT"
}
